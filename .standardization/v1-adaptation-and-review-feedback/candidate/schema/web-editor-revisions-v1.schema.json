{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Web Editor Revisions v1 normative schema",
  "description": "Normative structural contract for modelVersion 1 and serializationProfile json-jcs-1. Semantic requirements are defined by the Web Editor Revisions standard.",
  "type": "object",
  "additionalProperties": false,
  "required": ["modelVersion", "serializationProfile", "acceptedState", "proposals"],
  "properties": {
    "$schema": { "type": "string", "format": "uri" },
    "modelVersion": { "const": "1" },
    "serializationProfile": { "const": "json-jcs-1" },
    "acceptedState": { "$ref": "#/$defs/acceptedState" },
    "proposals": {
      "type": "array",
      "items": { "$ref": "#/$defs/proposal" }
    },
    "mappingReports": {
      "type": "array",
      "items": { "$ref": "#/$defs/mappingReport" }
    },
    "extensions": { "$ref": "#/$defs/extensions" }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1
    },
    "safeInteger": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "formatValues": {
      "type": "object",
      "additionalProperties": false,
      "required": ["italic", "bold", "underline", "strikethrough"],
      "properties": {
        "italic": { "type": "boolean" },
        "bold": { "type": "boolean" },
        "underline": { "type": "boolean" },
        "strikethrough": { "type": "boolean" }
      }
    },
    "formatRun": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end", "values"],
      "properties": {
        "start": { "$ref": "#/$defs/safeInteger" },
        "end": { "$ref": "#/$defs/safeInteger" },
        "values": { "$ref": "#/$defs/formatValues" }
      }
    },
    "fragment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "formatting"],
      "properties": {
        "text": { "type": "string" },
        "formatting": {
          "type": "array",
          "items": { "$ref": "#/$defs/formatRun" }
        }
      }
    },
    "paragraph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text", "formatting"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "text": { "type": "string" },
        "formatting": {
          "type": "array",
          "items": { "$ref": "#/$defs/formatRun" }
        }
      }
    },
    "acceptedState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fingerprint", "paragraphs"],
      "properties": {
        "fingerprint": { "$ref": "#/$defs/fingerprint" },
        "paragraphs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/paragraph" }
        }
      }
    },
    "association": {
      "enum": ["before", "after"]
    },
    "pointTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "paragraphId", "offset", "association"],
      "properties": {
        "type": { "const": "point" },
        "paragraphId": { "$ref": "#/$defs/identifier" },
        "offset": { "$ref": "#/$defs/safeInteger" },
        "association": { "$ref": "#/$defs/association" }
      }
    },
    "rangeEndpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["offset", "association"],
      "properties": {
        "offset": { "$ref": "#/$defs/safeInteger" },
        "association": { "$ref": "#/$defs/association" }
      }
    },
    "rangeTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "paragraphId", "start", "end"],
      "properties": {
        "type": { "const": "range" },
        "paragraphId": { "$ref": "#/$defs/identifier" },
        "start": { "$ref": "#/$defs/rangeEndpoint" },
        "end": { "$ref": "#/$defs/rangeEndpoint" }
      }
    },
    "boundaryTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "leftParagraphId", "rightParagraphId"],
      "properties": {
        "type": { "const": "paragraph-boundary" },
        "leftParagraphId": { "$ref": "#/$defs/identifier" },
        "rightParagraphId": { "$ref": "#/$defs/identifier" }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "creator": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "sourceSystem": { "type": "string" },
        "sourceProposalId": { "type": "string" },
        "resolver": { "type": "string" },
        "resolvedAt": { "type": "string", "format": "date-time" }
      }
    },
    "formatChange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["before", "after"],
      "properties": {
        "before": { "type": "boolean" },
        "after": { "type": "boolean" }
      }
    },
    "formatChanges": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "italic": { "$ref": "#/$defs/formatChange" },
        "bold": { "$ref": "#/$defs/formatChange" },
        "underline": { "$ref": "#/$defs/formatChange" },
        "strikethrough": { "$ref": "#/$defs/formatChange" }
      }
    },
    "proposalBase": {
      "type": "object",
      "required": ["id", "baseFingerprint", "state", "kind"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "baseFingerprint": { "$ref": "#/$defs/fingerprint" },
        "state": { "enum": ["pending", "accepted", "rejected"] },
        "kind": { "enum": ["insert", "delete", "replace", "format", "paragraph-split", "paragraph-merge"] },
        "provenance": { "$ref": "#/$defs/provenance" },
        "extensions": { "$ref": "#/$defs/extensions" }
      }
    },
    "proposal": {
      "oneOf": [
        {
          "allOf": [
            { "$ref": "#/$defs/proposalBase" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "baseFingerprint", "state", "kind", "target", "content", "samePointOrder"],
              "properties": {
                "id": { "$ref": "#/$defs/identifier" },
                "baseFingerprint": { "$ref": "#/$defs/fingerprint" },
                "state": { "enum": ["pending", "accepted", "rejected"] },
                "kind": { "const": "insert" },
                "target": { "$ref": "#/$defs/pointTarget" },
                "content": { "$ref": "#/$defs/fragment" },
                "samePointOrder": { "$ref": "#/$defs/safeInteger" },
                "provenance": { "$ref": "#/$defs/provenance" },
                "extensions": { "$ref": "#/$defs/extensions" }
              }
            }
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "baseFingerprint", "state", "kind", "target", "content"],
          "properties": {
            "id": { "$ref": "#/$defs/identifier" },
            "baseFingerprint": { "$ref": "#/$defs/fingerprint" },
            "state": { "enum": ["pending", "accepted", "rejected"] },
            "kind": { "const": "delete" },
            "target": { "$ref": "#/$defs/rangeTarget" },
            "content": { "$ref": "#/$defs/fragment" },
            "provenance": { "$ref": "#/$defs/provenance" },
            "extensions": { "$ref": "#/$defs/extensions" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "baseFingerprint", "state", "kind", "target", "oldContent", "newContent"],
          "properties": {
            "id": { "$ref": "#/$defs/identifier" },
            "baseFingerprint": { "$ref": "#/$defs/fingerprint" },
            "state": { "enum": ["pending", "accepted", "rejected"] },
            "kind": { "const": "replace" },
            "target": { "$ref": "#/$defs/rangeTarget" },
            "oldContent": { "$ref": "#/$defs/fragment" },
            "newContent": { "$ref": "#/$defs/fragment" },
            "provenance": { "$ref": "#/$defs/provenance" },
            "extensions": { "$ref": "#/$defs/extensions" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "baseFingerprint", "state", "kind", "target", "changes"],
          "properties": {
            "id": { "$ref": "#/$defs/identifier" },
            "baseFingerprint": { "$ref": "#/$defs/fingerprint" },
            "state": { "enum": ["pending", "accepted", "rejected"] },
            "kind": { "const": "format" },
            "target": { "$ref": "#/$defs/rangeTarget" },
            "changes": { "$ref": "#/$defs/formatChanges" },
            "provenance": { "$ref": "#/$defs/provenance" },
            "extensions": { "$ref": "#/$defs/extensions" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "baseFingerprint", "state", "kind", "target", "newRightParagraphId"],
          "properties": {
            "id": { "$ref": "#/$defs/identifier" },
            "baseFingerprint": { "$ref": "#/$defs/fingerprint" },
            "state": { "enum": ["pending", "accepted", "rejected"] },
            "kind": { "const": "paragraph-split" },
            "target": { "$ref": "#/$defs/pointTarget" },
            "newRightParagraphId": { "$ref": "#/$defs/identifier" },
            "provenance": { "$ref": "#/$defs/provenance" },
            "extensions": { "$ref": "#/$defs/extensions" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "baseFingerprint", "state", "kind", "target"],
          "properties": {
            "id": { "$ref": "#/$defs/identifier" },
            "baseFingerprint": { "$ref": "#/$defs/fingerprint" },
            "state": { "enum": ["pending", "accepted", "rejected"] },
            "kind": { "const": "paragraph-merge" },
            "target": { "$ref": "#/$defs/boundaryTarget" },
            "provenance": { "$ref": "#/$defs/provenance" },
            "extensions": { "$ref": "#/$defs/extensions" }
          }
        }
      ]
    },
    "extensionEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "value"],
      "properties": {
        "required": { "type": "boolean" },
        "value": {}
      }
    },
    "extensions": {
      "type": "object",
      "propertyNames": { "format": "uri" },
      "additionalProperties": { "$ref": "#/$defs/extensionEntry" }
    },
    "mappingIssue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "fields", "condition", "action", "impact", "recoverability", "expected", "observed"],
      "properties": {
        "stage": { "type": "string", "minLength": 1 },
        "proposalIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "fields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "condition": { "enum": ["source-absent", "unsupported", "unavailable", "invalid-input", "precondition-failed", "persistence-failure", "other"] },
        "action": { "enum": ["synthesized", "normalized", "approximated", "omitted", "materialized", "refused", "rolled-back", "partially-committed", "other"] },
        "impact": { "enum": ["none", "optional-information-loss", "review-semantics-loss", "transaction-integrity-failure"] },
        "recoverability": { "enum": ["not-applicable", "retryable", "requires-intervention", "irrecoverable", "unknown"] },
        "extensionId": { "type": "string", "format": "uri" },
        "expected": {},
        "observed": {},
        "explanation": { "type": "string" }
      }
    },
    "mappingReport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "adapter", "profile", "direction", "boundary", "inputRef", "outputRef", "outputMutation", "authorizedActions", "outcome", "issues"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "adapter": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "version"],
          "properties": {
            "id": { "$ref": "#/$defs/identifier" },
            "version": { "type": "string", "minLength": 1 }
          }
        },
        "profile": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "version"],
          "properties": {
            "id": { "$ref": "#/$defs/identifier" },
            "version": { "type": "string", "minLength": 1 }
          }
        },
        "direction": { "type": "string", "minLength": 1 },
        "boundary": { "type": "string", "minLength": 1 },
        "inputRef": { "type": "string", "minLength": 1 },
        "outputRef": { "type": ["string", "null"] },
        "outputMutation": { "enum": ["none", "valid-complete", "valid-lossy", "residual-invalid"] },
        "authorizedActions": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["approximated", "omitted", "materialized"] }
        },
        "outcome": { "enum": ["equivalent", "equivalent-with-declared-adaptation", "lossy", "unsupported", "failed"] },
        "issues": {
          "type": "array",
          "items": { "$ref": "#/$defs/mappingIssue" }
        }
      }
    }
  }
}
