{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Web Editor Revisions mapping-profile claim package manifest version 2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "claimFormat",
    "publication",
    "profile",
    "implementation",
    "boundary",
    "run",
    "fixtures",
    "claimResult",
    "limitations"
  ],
  "properties": {
    "claimFormat": {"const": "web-editor-revisions-profile-claim-2"},
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "modelVersion", "serializationProfile"],
      "properties": {
        "commit": {"type": "string", "minLength": 7},
        "modelVersion": {"const": "1"},
        "serializationProfile": {"const": "json-jcs-1"}
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "direction", "claimScope", "capabilities"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "direction": {"type": "string", "minLength": 1},
        "claimScope": {"enum": ["safety-only", "proposal-mapping"]},
        "capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": ["insert", "delete", "replace", "format", "paragraph-split", "paragraph-merge"]
          }
        }
      }
    },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["upstreamVersion", "scope", "persistence", "sourcePersistenceClaimed"],
      "properties": {
        "upstreamVersion": {"type": "string", "minLength": 1},
        "scope": {"type": "string", "minLength": 1},
        "persistence": {"type": "string", "minLength": 1},
        "sourcePersistenceClaimed": {"type": "boolean"}
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startedAt", "finishedAt", "environment", "coreSuite"],
      "properties": {
        "startedAt": {"type": "string", "format": "date-time"},
        "finishedAt": {"type": "string", "format": "date-time"},
        "environment": {"type": "string", "minLength": 1},
        "coreSuite": {
          "type": "object",
          "additionalProperties": false,
          "required": ["command", "passed", "total", "artifact"],
          "properties": {
            "command": {"type": "string", "minLength": 1},
            "passed": {"type": "integer", "minimum": 0},
            "total": {"type": "integer", "minimum": 1},
            "artifact": {"$ref": "#/$defs/artifact"}
          }
        }
      }
    },
    "fixtures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "expected", "observed", "artifacts"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "status": {"enum": ["passed", "failed", "not-run"]},
          "expected": {"type": "string", "minLength": 1},
          "observed": {"type": "string", "minLength": 1},
          "artifacts": {
            "type": "array",
            "minItems": 1,
            "items": {"$ref": "#/$defs/artifact"}
          }
        }
      }
    },
    "claimResult": {"enum": ["pass", "fail"]},
    "limitations": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "path", "sha256"],
      "properties": {
        "role": {
          "enum": [
            "input",
            "output",
            "core-document",
            "mapping-report",
            "acceptance-projection",
            "rejection-projection",
            "persistence-observation",
            "no-mutation-proof",
            "log"
          ]
        },
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
